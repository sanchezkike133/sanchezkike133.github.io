---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout>
  <!-- Menú de navegación -->
  <nav class="fixed top-0 left-0 w-full p-4 bg-gray-800 text-white flex justify-center space-x-6 z-50">
    <a href="#principal" class="hover:underline">Principal</a>
    <a href="#habilidades" class="hover:underline">Habilidades</a>
    <a href="#proyectos" class="hover:underline">Proyectos</a>
    <a href="#contacto" class="hover:underline">Contacto</a>
  </nav>

  <!-- Sección Principal -->
  <section id="principal" class="min-h-screen flex flex-col items-center justify-center bg-blue-100">
    <h1 class="text-5xl font-bold">Hola, soy Kike</h1>
    <p class="mt-4 text-xl">Bienvenido a mi portafolio</p>
  </section>

  <!-- Sección Habilidades -->
  <section id="habilidades" class="min-h-screen p-8 bg-gray-100">
    <h2 class="text-3xl font-bold mb-4">Habilidades</h2>
    <ul class="list-disc ml-6 space-y-2">
      <li>HTML / CSS / JavaScript</li>
      <li>Astro / TailwindCSS</li>
      <li>GitHub</li>
      <li>Node.js / npm</li>
	  <li>Circuitos electronicos con arduino</li>

    </ul>
  </section>

  <!-- Sección Proyectos -->
  <section id="proyectos" class="min-h-screen p-8 bg-white">
    <h2 class="text-3xl font-bold mb-4">Proyectos</h2>
    <ul class="list-disc ml-6 space-y-2">
      <li><a href="https://github.com/sanchezkike133/proyecto1" target="_blank" class="text-blue-600 hover:underline">Proyectos con c++</a></li>
      <li><a href="https://github.com/sanchezkike133/proyecto2" target="_blank" class="text-blue-600 hover:underline">Proyecto con flask</a></li>
      <li><a href="https://github.com/sanchezkike133/proyecto3" target="_blank" class="text-blue-600 hover:underline">Proyecto con arduino</a></li>
    </ul>
  </section>

  <!-- Sección Contacto -->
  <section id="contacto" class="min-h-screen p-8 bg-gray-100">
    <h2 class="text-3xl font-bold mb-4">Contacto</h2>
    <ContactForm />
  </section>
</Layout>
