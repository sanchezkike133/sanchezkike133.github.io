---
// blog/[id].astro - Página de post individual
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";

function formatDate(date: Date): string {
  return date.toLocaleDateString("es-MX", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}

// Tiempo de lectura
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.ceil(wordCount / 200);
---

<Layout>
  <article class="pt-24 pb-12 px-4 max-w-3xl mx-auto">
    <!-- Navegación -->
    <a
      href={`${normalizedBase}blog/`}
      class="text-blue-600 hover:underline text-sm mb-6 inline-block"
    >
      ← Volver al blog
    </a>

    <!-- Header -->
    <header class="mb-8">
      <p class="text-gray-500 text-sm mb-2">
        {formatDate(post.data.date)} · {readingTime} min de lectura
      </p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {post.data.title}
      </h1>
      <p class="text-gray-600 text-lg">
        {post.data.description}
      </p>
    </header>

    <!-- Imagen -->
    <div class="rounded-xl overflow-hidden mb-8">
      <img
        src={post.data.image}
        alt={post.data.title}
        class="w-full h-auto object-cover"
      />
    </div>

    <!-- Contenido -->
    <div
      class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-a:text-blue-600"
    >
      <Content />
    </div>

    <!-- Volver -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <a href={`${normalizedBase}blog/`} class="text-blue-600 hover:underline">
        ← Ver todos los artículos
      </a>
    </div>
  </article>
</Layout>
